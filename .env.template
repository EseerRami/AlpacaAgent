# =====================================================================
# AlpacaAgent .env template
# Copy this file to `.env` (no extension) and fill in the four keys below.
# =====================================================================

# Alpaca PAPER credentials — use the SECOND Alpaca paper account you created
# (NOT the same keys as your existing alpaca-bot, otherwise the LLM agent will
# share positions with that bot and the 3-way comparison won't work).
ALPACA_KEY=PK_YOUR_SECOND_ACCOUNT_KEY_HERE
ALPACA_SECRET=YOUR_SECOND_ACCOUNT_SECRET_HERE
ALPACA_URL=https://paper-api.alpaca.markets/v2

# Tavily — sign up free at https://tavily.com (1,000 searches/mo on free tier)
TAVILY_API_KEY=tvly-YOUR_TAVILY_KEY_HERE

# Anthropic — same key you already use for Claude (or generate a new one)
# Free Claude Haiku usage costs ~$0.001/cycle so a day of 200 cycles is ~$0.20
ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_KEY_HERE

# Optional overrides
# MODEL=anthropic:claude-3-5-haiku-latest
# STATE_KEY=btc-eth-agent
# ALLOW_TRADING=true
# BASE_PROMPT=Scan recent news for BTC, ETH, SOL ...
